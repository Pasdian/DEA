function generaListaArch(tipo,matriz){
    var lista="";
    $("#contenidos").empty();
    switch(tipo){
        case "PDF":
            lista="<div style='text-align: center;width: 100%;'><h2>Archivos y Orden</h2><div id='mergePDF'>";
            $.each(matriz,function(carpeta,v){
                $.each(v,function(k,v){
                    if(v.substring(v.lastIndexOf(".")+1).toUpperCase()==tipo)
                        lista=lista+"<div><h4 archivo='"+datosApp.clienteAct+"/"+datosApp.referenciaSeleccionada+"/"+carpeta+"/"+v+"'>"+v+"</h4></div>";
                });	
            });
            lista=lista+"<br></div><br><br><input type='button' onclick='unirArchivos()' value='Proceder'></div>";
            break;
        default:
            break;
    }
    $("#contenidos").append(lista);
    $("#mergePDF")
        .accordion({
            heightStyle: "fill",
            header: "> div > h4"
        })
        .sortable({
            axis: "y",
            handle: "h4",
            stop: function( event, ui ) {
                ui.item.children( "h4" ).triggerHandler( "focusout" );
                $( this ).accordion( "refresh" );
            }
        });
}

function unirArchivos(){
    Espera(true);
    unir=Array();
    $("#msgInf").html("Uniendo archivos");
    $("#mergePDF h4").each(function(i){
        unir[i]="/var/Gestion/"+$($("#mergePDF h4")[i]).attr("archivo");
    });
    $("#contenidos").load(
                "php/mpdf.php",
                {obJson:JSON.stringify(unir),referencia:datosApp.referenciaSeleccionada,cte:datosApp.clienteAct},
                function(){
                    referencias();
                    //procesoID = setInterval(cargaED, 100);
                });
}

