function zipDM(){
    ozip={"cliente":datosApp.clienteAct};
    $.each(datosApp.referencias,function(i,r){
        ozip[i]=[];
        $.each(r,function(j,c){
            $.each(c,function(k){
                if($("#dm_cg").is(':checked') && this.indexOf("_1CtaG_") > -1)
                    ozip[i].push(j+"/"+this);
                if($("#dm_fac").is(':checked') && this.indexOf("_2Fact_") > -1)
                    ozip[i].push(j+"/"+this);
                if($("#dm_ped").is(':checked') && this.indexOf("_2PNOR_") > -1)
                    ozip[i].push(j+"/"+this);
                if($("#dm_mv").is(':checked') && (this.indexOf("_6MANV") > -1 || this.indexOf("_7HOJC") > -1 || this.indexOf("_8AHJC") > -1))
                    ozip[i].push(j+"/"+this);
            });
       });
    });
    $("#msgInf").html("Generando Archivo comprimido");
    Espera(true);
    recibeBlobAjax("php/zipDM.php",ozip);   
}
